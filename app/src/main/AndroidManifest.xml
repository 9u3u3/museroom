<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only ever used to tell you somebody asked to listen along. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Proximity, over Bluetooth Low Energy. neverForLocation is the important
        part: it tells Android we do not use scan results to work out where the
        user is, which is true and means we never ask for location on Android 12
        and up. Older versions have no such option, so they need location.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Museroom plays the music itself when you listen along with somebody, so
        it has to keep playing once you leave the screen. Declaring the service
        as media playback is how the system is told that audio is the point.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!--
        Package visibility (Android 11+). We never read these apps' data directly;
        we only need to resolve their labels and, later, deep links into them.
    -->
    <queries>
        <!--
            Any app that can handle a media button is a player. This narrow filter
            is what lets us show a real app name for a player we do not recognise,
            such as a fork with its own package name.
        -->
        <intent>
            <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent>
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.apps.youtube.music" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Museroom">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Museroom">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Signing in to YouTube Music, once, so a listening room plays without
            ads for anybody who pays for that and plays at all for everybody
            else. Its own window because a sign-in page is the one part of this
            the person genuinely has to see.
        -->
        <activity
            android:name=".sync.YouTubeSignInActivity"
            android:exported="false"
            android:label="@string/sign_in_music_label"
            android:theme="@style/Theme.Museroom" />

        <!-- Saying yes or no from the notification, without opening anything. -->
        <receiver
            android:name=".notify.ListenActions"
            android:exported="false">
            <intent-filter>
                <action android:name="com.museroom.app.LISTEN_ACCEPT" />
                <action android:name="com.museroom.app.LISTEN_DECLINE" />
            </intent-filter>
        </receiver>

        <!-- Keeps a room playing while Museroom is not the app on screen. -->
        <service
            android:name=".sync.RoomService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!--
            Enabling this component in Settings is what grants access to
            MediaSessionManager.getActiveSessions(). The service itself does very
            little; it exists to hold the permission and to nudge a resync.
        -->
        <service
            android:name=".listener.MediaListenerService"
            android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
