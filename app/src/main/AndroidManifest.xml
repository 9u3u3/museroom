<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Package visibility (Android 11+). We never read these apps' data directly;
        we only need to resolve their labels and, later, deep links into them.
    -->
    <queries>
        <!--
            Any app that can handle a media button is a player. This narrow filter
            is what lets us show a real app name for a player we do not recognise,
            such as a fork with its own package name.
        -->
        <intent>
            <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent>
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.apps.youtube.music" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Museroom">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Museroom">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Enabling this component in Settings is what grants access to
            MediaSessionManager.getActiveSessions(). The service itself does very
            little; it exists to hold the permission and to nudge a resync.
        -->
        <service
            android:name=".listener.MediaListenerService"
            android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
