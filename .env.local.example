# Copy to .env.local and fill in. .env.local is gitignored and never leaves this machine.
# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Project Settings -> Database -> Connection string -> URI
# Prefer "Direct connection"; if that will not connect, use "Session pooler".
# Not the transaction pooler, migrations need a session.
SUPABASE_DB_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Do NOT put the service_role key here. Nothing in this project needs it.

# Google Cloud -> APIs & Services -> enable "YouTube Data API v3",
# then Credentials -> Create API key. Restrict it to Android apps with
# package com.museroom.app and the signing SHA-1.
YOUTUBE_API_KEY=
